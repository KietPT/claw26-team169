GITLAB_BASE_URL=https://git.company.vn
JIRA_BASE_URL=https://jira.company.vn
DELIVERY_CHANNEL=telegram
DEFAULT_DIGEST_TIME=17:00
# Run at several times per day (CSV HH:MM). Overrides DEFAULT_DIGEST_TIME when set:
DIGEST_TIMES=08:30,17:30
# Days to run (cron day-of-week expr). Default mon-fri = skip weekends:
DIGEST_DAYS=mon-fri
TIMEZONE=Asia/Ho_Chi_Minh
FETCH_WINDOW_DAYS=30
# Flag MRs/tickets with no update for >= N days as stale (badge + bumped to "needs action"):
STALE_AFTER_DAYS=7
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_DIR=./reports
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m2.5
# Required credentials — leave EMPTY here; fill them in the web UI (per-user, never baked into the build):
JIRA_EMAIL=
JIRA_TOKEN=
# your personal PATs:
GITLAB_TOKEN=
